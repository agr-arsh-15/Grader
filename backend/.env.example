# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# PostgreSQL connection (psycopg3 async driver)
DATABASE_URL=postgresql+psycopg://grader:graderpass@localhost:5432/graderdb

# JWT — must be a long, random secret (>=32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Shared secret between backend and grading service for the /api/internal/* endpoints
INTERNAL_API_KEY=CHANGE_ME_another_secure_random_secret_here

# URL where the Python grading service is running
GRADING_SERVICE_URL=http://localhost:5100

# Base URL of this backend (used by grading service for the callback)
BACKEND_URL=http://localhost:8000

# File upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Seed admin account — used by seed.py only
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@changeme1!
